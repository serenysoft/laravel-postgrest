{
    "name": "sereny/postgrest",
    "description": "A PostgREST connection driver that lets Laravel Eloquent models talk to a PostgREST server over HTTP.",
    "keywords": [
        "laravel",
        "postgrest",
        "postgres",
        "eloquent",
        "database",
        "driver"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Sereny"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Sereny\\PostgREST\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sereny\\PostgREST\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sereny\\PostgREST\\PostgrestServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    }
}
